{
  "name": "@fashion/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "test": "vitest run --exclude dist/**",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fashion/db": "workspace:*",
    "@fashion/shared": "workspace:*",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "heic-decode": "^2.1.0",
    "openai": "^6.16.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/heic-decode": "^2.0.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
