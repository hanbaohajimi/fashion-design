API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# 可观测性：未配置 DSN/token 时 SDK 保持静默；Sentry auth token 仅用于构建期上传 source map。
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 运行 pnpm auth:start 后，将 pnpm auth:status 输出的 API URL 和 publishable/anon key 填入此处。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

POSTGRES_PORT=5432
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion_dev
POSTGRES_DB=fashion_design
DATABASE_URL=postgresql://fashion:fashion_dev@localhost:5432/fashion_design?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# 每周一 02:00（默认 Asia/Shanghai）采集趋势。Brave freshness=pw 限制最近 7 天。
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
TREND_DIGEST_TIMEZONE=Asia/Shanghai
# 趋势封面沿用私有 FileAsset；填写一个系统用户 id 作为文件所有者。留空时仅保存趋势文本。
TREND_ASSET_OWNER_ID=
# Claude 结构化输出；默认模型使用当前可用的 Sonnet 4.6。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# 本地开发默认使用 S3 兼容的 MinIO；生产可替换为 Cloudflare R2 或 AWS S3。
# 外部 bucket 需允许 APP_ORIGIN 对 PUT/GET/HEAD 发起 CORS 请求；原图与缩略图均保持私有并通过鉴权签名 URL 读取。
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fashion-assets
S3_HEALTHCHECK_OBJECT_KEY=.health/ready
S3_ACCESS_KEY_ID=fashion_minio
S3_SECRET_ACCESS_KEY=fashion_minio_dev_secret
S3_FORCE_PATH_STYLE=true
ASSET_CDN_ORIGIN=http://localhost:9000/fashion-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 图片角色识别、提示词增强、系列 DNA 和生成结果审核统一由 Amux Claude 承担。
# 图片角色推断仍在 Worker 中异步执行，不阻塞上传；调用失败时安全回退为 style_ref。
# 系列 DNA 提取失败时仍会创建可手填的空 DNA。
# 系列 Look 完成后由独立 Worker 计算 CLIP 参考相似度；仅持久化分数，不持久化 embedding。
CLIP_MODEL_ID=Xenova/clip-vit-base-patch32
# Lookbook 中文字体；Windows 默认自动探测微软雅黑，Linux 生产环境建议显式挂载 Noto Sans CJK。
EXPORT_PDF_FONT_PATH=
EXPORT_PDF_FONT_FAMILY=
# 生图 Provider：默认使用 Amux 的 special/openai 渠道。
# API 请求仍只负责写入 BullMQ；同步的 Amux 调用在 Worker 中执行，不阻塞页面请求。
AI_PRIMARY_PROVIDER=amux
# 百炼 API Key 和业务空间域名配置完成后，可填写 dashscope 启用自动降级。
AI_FALLBACK_PROVIDER=
# Amux 高质量生图可能排队；Provider 最长等待 10 分钟，Worker 总任务预留 12 分钟。
AI_PROVIDER_TIMEOUT_MS=600000
GENERATION_TIMEOUT_MS=720000
# Provider 内不叠加重试；生成队列仍会对可恢复故障重试一次，降低重复消费风险。
AI_PROVIDER_RETRY_BASE_MS=250
AI_CREDITS_PER_USD=100
AI_CREDITS_PER_CNY=0
# 默认自动允许 S3_ENDPOINT 与 ASSET_CDN_ORIGIN；额外来源以英文逗号分隔，禁止填写不受信任的通配域名。
AI_REFERENCE_IMAGE_ALLOWED_ORIGINS=

# 同一个 Amux 令牌需同时包含 special/anthropic 与 special/openai 分组。
# Claude 只处理识别、提示词、DNA 和审核；GPT Image 只负责实际生图。
AMUX_API_KEY=
AMUX_BASE_URL=https://api.amux.ai/v1
AMUX_CLAUDE_MODEL=claude-sonnet-5
AMUX_CLAUDE_TIMEOUT_MS=20000
AMUX_IMAGE_MODEL=gpt-image-2
AMUX_IMAGE_QUALITY=high
# 按 Amux 控制台实际单价填写，单位 USD/张；0 表示仅记录调用次数、不估算渠道成本。
AMUX_IMAGE_COST_USD=0
AMUX_EDIT_COST_USD=0

# 阿里云百炼预留渠道：目前承接 t2i/i2i，不承接精确蒙版 inpaint。
DASHSCOPE_API_KEY=
# 生产建议换成百炼业务空间专属域名：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro
DASHSCOPE_IMAGE_SIZE=2K
# 单位 CNY/张；同时按项目的额度换算规则设置 AI_CREDITS_PER_CNY。
DASHSCOPE_IMAGE_COST_CNY=0

# 新用户的默认免费生成次数；已有用户的额度可直接由后台修改 generation_limit。
DEFAULT_GEN_LIMIT=100
