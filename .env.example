API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# 运行 pnpm auth:start 后，将 pnpm auth:status 输出的 API URL 和 publishable/anon key 填入此处。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

POSTGRES_PORT=5432
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion_dev
POSTGRES_DB=fashion_design
DATABASE_URL=postgresql://fashion:fashion_dev@localhost:5432/fashion_design?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# 本地开发默认使用 S3 兼容的 MinIO；生产可替换为 Cloudflare R2 或 AWS S3。
# 外部 bucket 需允许 APP_ORIGIN 对 PUT/GET/HEAD 发起 CORS 请求，并只公开 thumbnails/ 前缀。
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fashion-assets
S3_ACCESS_KEY_ID=fashion_minio
S3_SECRET_ACCESS_KEY=fashion_minio_dev_secret
S3_FORCE_PATH_STYLE=true
ASSET_CDN_ORIGIN=http://localhost:9000/fashion-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 图片角色推断由 Worker 异步调用，不会阻塞上传；未配置密钥时安全回退为 style_ref。
OPENAI_API_KEY=
OPENAI_VLM_MODEL=gpt-4o-mini
# 白板上下文的结构化标签与术语规范化；失败时自动回退到本地关键词编译。
OPENAI_COMPILER_MODEL=gpt-4o-mini

# AI Provider 通过名称切换；生成请求只提交远端队列，不在 API 请求中等待出图。
AI_PRIMARY_PROVIDER=fal
AI_FALLBACK_PROVIDER=
AI_PROVIDER_TIMEOUT_MS=60000
AI_PROVIDER_RETRY_BASE_MS=250
AI_CREDITS_PER_USD=100
FAL_KEY=
FAL_T2I_MODEL=fal-ai/flux/dev
FAL_I2I_MODEL=fal-ai/flux/dev/image-to-image
# 单价由 fal 控制台当前合同填写，单位 USD/MP；禁止在业务代码中固化易变价格。
FAL_T2I_COST_PER_MEGAPIXEL=0
FAL_I2I_COST_PER_MEGAPIXEL=0

# 新用户的默认免费生成次数；已有用户的额度可直接由后台修改 generation_limit。
DEFAULT_GEN_LIMIT=100
