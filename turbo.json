{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "AI_CREDITS_PER_USD",
    "AI_FALLBACK_PROVIDER",
    "AI_PRIMARY_PROVIDER",
    "AI_PROVIDER_RETRY_BASE_MS",
    "AI_PROVIDER_TIMEOUT_MS",
    "API_INTERNAL_URL",
    "API_PORT",
    "APP_ORIGIN",
    "ASSET_CDN_ORIGIN",
    "DATABASE_URL",
    "DEFAULT_GEN_LIMIT",
    "FAL_I2I_COST_PER_MEGAPIXEL",
    "FAL_I2I_MODEL",
    "FAL_KEY",
    "FAL_T2I_COST_PER_MEGAPIXEL",
    "FAL_T2I_MODEL",
    "NEXT_PUBLIC_TLDRAW_LICENSE_KEY",
    "REDIS_URL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SESSION_COOKIE_SECURE",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
