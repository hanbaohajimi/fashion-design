{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.example"],
  "globalPassThroughEnv": [
    "AI_CREDITS_PER_CNY",
    "AI_CREDITS_PER_USD",
    "AI_FALLBACK_PROVIDER",
    "AI_PRIMARY_PROVIDER",
    "AI_PROVIDER_RETRY_BASE_MS",
    "AI_PROVIDER_TIMEOUT_MS",
    "AI_REFERENCE_IMAGE_ALLOWED_ORIGINS",
    "AMUX_API_KEY",
    "AMUX_BASE_URL",
    "AMUX_CLAUDE_MODEL",
    "AMUX_CLAUDE_TIMEOUT_MS",
    "AMUX_EDIT_COST_USD",
    "AMUX_IMAGE_COST_USD",
    "AMUX_IMAGE_MODEL",
    "AMUX_IMAGE_QUALITY",
    "API_PORT",
    "APP_ORIGIN",
    "ASSET_CDN_ORIGIN",
    "DATABASE_URL",
    "DEFAULT_GEN_LIMIT",
    "DASHSCOPE_API_KEY",
    "DASHSCOPE_BASE_URL",
    "DASHSCOPE_IMAGE_COST_CNY",
    "DASHSCOPE_IMAGE_MODEL",
    "DASHSCOPE_IMAGE_SIZE",
    "GENERATION_TIMEOUT_MS",
    "REDIS_URL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_HEALTHCHECK_OBJECT_KEY",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SESSION_COOKIE_SECURE",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_INTERNAL_URL",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_TLDRAW_LICENSE_KEY",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT"
      ],
      "outputs": [".next/**", "dist/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
