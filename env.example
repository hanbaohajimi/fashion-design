# Copy this file to .env at project root and edit as needed (do NOT commit .env)
#
# Frontend dev port (keep in sync with vite.config.ts server.port)
FASHION_FRONTEND_PORT=3100

# Design backend: directory containing server.py
# Default (self-contained): server.py is already included at backend/design-studio/server.py
# Uncomment only if using a different location:
# FASHION_DESIGN_BACKEND=./backend/design-studio

# Trend backend: directory containing api/ package or api.py
# Default: auto-detected at ai_fashion/ai_fashion/ (already in this repo)
# Uncomment only if using a different location:
# AI_FASHION_BACKEND=./ai_fashion/ai_fashion

# Force stub services: 1/true = stub only; 0/false = require full backend (exit if missing)
# FASHION_DESIGN_USE_STUB=auto
# FASHION_TREND_USE_STUB=auto
