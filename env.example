# ============================================================
# AI Fashion Design Platform — 统一配置模板
# 复制此文件为 .env 并填写实际值（不要提交 .env 到 git）
# ============================================================

# ─── 前端端口 ───
FASHION_FRONTEND_PORT=3100

# ─── 前端调试开关（可选）───
# Legacy Trend iframe 默认隐藏；开发调试时打开此项后重启前端
# VITE_SHOW_LEGACY_TREND_IFRAME=false

# 浏览器允许访问后端的来源，多个来源用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# 设计服务登录会话：空闲超时（分钟）与绝对有效期（小时）
AUTH_IDLE_TIMEOUT_MINUTES=60
AUTH_ABSOLUTE_TIMEOUT_HOURS=168

# ─── 设计后端路径（可选，默认使用内置 server.py）───
# FASHION_DESIGN_BACKEND=
# FASHION_DESIGN_USE_STUB=auto

# ─── 趋势后端路径（可选，默认自动检测）───
# AI_FASHION_BACKEND=
# FASHION_TREND_USE_STUB=auto

# ============================================================
# 设计 AI — amux.ai 中转站（OpenAI 兼容）
# 模型: gpt-image-2 (绘图/编辑/试穿), gemini-3-pro-preview (对话+视觉)
# 申请: https://api.amux.ai
# ============================================================
AMUX_API_KEY=
# AMUX_BASE_URL=https://api.amux.ai/v1
# AMUX_TEXT_MODEL=gemini-3-pro-preview   # 可选: claude-sonnet-4-6 / gpt-5.2
# AMUX_IMAGE_MODEL=gpt-image-2
# AMUX_VISION_MODEL=gemini-3-pro-preview
# AMUX_IMAGE_EDIT_MODEL=gpt-image-2
# AMUX_TRYON_MODEL=gpt-image-2

# ============================================================
# 趋势 LLM — DeepSeek（通过 LiteLLM 调用，也支持 openai / anthropic / local）
# 申请: https://platform.deepseek.com
# ============================================================
# LLM_PROVIDER=deepseek        # LiteLLM 提供者: deepseek / openai / anthropic / local
# LLM_MODEL=deepseek-v4-pro
# LLM_FALLBACK_MODEL=
# LLM_BASE_URL=https://api.deepseek.com
API_KEY=

# ============================================================
# 统一模型路由（可选；不填则沿用上方 AMUX_* / LLM_*）
# 支持 JSON 或单项环境变量。fallback 若跨 provider，建议写 LiteLLM 完整前缀，如 deepseek/deepseek-v4。
# ============================================================
# MODEL_ROUTES_JSON={"design_chat":{"primary":"gpt-5.5","fallback":"deepseek/deepseek-v4-pro"},"image_generation":{"primary":"gpt-image-2"},"trend_analysis":{"primary":"claude-sonnet","fallback":"deepseek/deepseek-v4"}}
# MODEL_DESIGN_CHAT_PRIMARY=
# MODEL_DESIGN_CHAT_FALLBACK=
# MODEL_VISION_TAGGING_PRIMARY=
# MODEL_IMAGE_GENERATION_PRIMARY=
# MODEL_IMAGE_EDIT_PRIMARY=
# MODEL_VIRTUAL_TRYON_PRIMARY=
# MODEL_TREND_ANALYSIS_PRIMARY=
# MODEL_TREND_ANALYSIS_FALLBACK=

# ============================================================
# 趋势搜索 — 阿里云百炼 Qwen（可选，不填则跳过搜索阶段）
# 申请: https://dashscope.aliyuncs.com
# ============================================================
# QWEN_API_KEY=
# QWEN_MODEL=qwen3-max
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
