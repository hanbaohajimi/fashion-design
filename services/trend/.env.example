# ============================================================
# .env.example — 全局配置占位模板
# 复制为 .env 并填写实际值（.env 不要提交到 git）
# ============================================================

# ── 目录配置（留空则使用项目内默认路径）─────────────────────
OUTPUT_DIR=""            # 趋势报告输出目录，留空=./output
LOG_DIR=""               # 日志目录，留空=./logs
DB_PATH=""               # SQLite 数据库路径，留空=./storage/fashion_pipeline.db
DATA_DIR=""              # 数据根目录，留空=./data

# ── LLM 配置（必填）─────────────────────────────────────────
LLM_PROVIDER=""          # TODO: openai / anthropic / local
LLM_MODEL=""             # TODO: gpt-4o / claude-3-5-sonnet-20241022 / llama3 等
API_KEY=""               # TODO: 对应 provider 的 API Key
LLM_BASE_URL=""          # TODO: 本地/代理模型的 base_url（可选）
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# 单次 LLM HTTP 超时（秒）；过短会导致长耗时趋势分析被误判为 APITimeoutError
LLM_REQUEST_TIMEOUT=180

# ── Qwen Web Search 配置（搜索阶段）──────────────────────────
QWEN_API_KEY=""          # TODO: 阿里云百炼 API Key
QWEN_MODEL="qwen3-max"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_SEARCH_STRATEGY="turbo"
SEARCH_CANDIDATE_LIMIT=0
SEARCH_SELECTED_LIMIT=0

# ── 调度配置 ─────────────────────────────────────────────────
SCHEDULE_HOURS=24        # TODO: 调度间隔（小时），默认 24
TIMEZONE="Asia/Shanghai" # TODO: 时区

# ── 爬虫配置 ─────────────────────────────────────────────────
USER_AGENT=""            # TODO: 留空则使用内置 Chrome UA
MAX_CONCURRENCY=3        # TODO: 最大并发数（建议 2-5）
REQUEST_TIMEOUT=30       # TODO: 单次请求超时（秒）
RETRY_TIMES=3            # TODO: 失败重试次数
RETRY_MIN_WAIT=2.0       # 重试最小等待（秒）
RETRY_MAX_WAIT=30.0      # 重试最大等待（秒）
# Playwright 专用 HTTP 代理（与浏览器系统代理无关）。外站报 ERR_CONNECTION_CLOSED 时可填，例如：
# PLAYWRIGHT_PROXY_SERVER=http://127.0.0.1:7890

# ── 存储配置 ─────────────────────────────────────────────────
# 支持多选（逗号分隔）：sqlite,json,markdown
STORE_BACKEND="sqlite,json,markdown"

# ── 图片配置 ─────────────────────────────────────────────────
MAX_IMAGES_PER_ARTICLE=5  # 每篇传给 LLM 的最大图片数
IMAGE_INPUT_MODE="url"    # TODO: url / base64 / none

# ── OCR 降级 ─────────────────────────────────────────────────
ENABLE_OCR_FALLBACK=false # TODO: 若 LLM 不支持视觉，改为 true
OCR_ENGINE="tesseract"    # tesseract / easyocr

# ── 内容处理 ─────────────────────────────────────────────────
MAX_CONTENT_LENGTH=4000   # 单篇文章传给 LLM 的最大字符数
MAX_ARTICLES_PER_BATCH=0  # 0 表示不限制单批 LLM 分析文章数

# ── 趋势分析：文章质量门槛（高质量择优进入 LLM）──────────────
ENABLE_ARTICLE_QUALITY_GATE=true
MIN_ARTICLE_TITLE_CHARS=4
MIN_ARTICLE_BODY_CHARS=160
# 时尚语义相关分低于此值的稿件不进入分析（约 0~60；0=不按相关度剔除，仅排序截断）
MIN_FASHION_RELEVANCE_SCORE=10
# true：去掉不含「时尚趋势」向信息的文章（显式趋势词/大秀季次语境/极高时尚语义分）
STRICT_FASHION_TREND_FILTER=true
UNANALYZED_ARTICLE_POOL_LIMIT=400
# 全库季节分析：从 SQLite 拉取的最大文章数（含曾分析过的），用于「analyze_library」模式
LIBRARY_SEASON_ARTICLE_POOL_LIMIT=0
# 每轮实际送入趋势分析的最大篇数；0 表示不限制
MAX_ARTICLES_PER_ANALYSIS_RUN=0

# ── robots.txt ───────────────────────────────────────────────
# true：遵守站点规则（默认，生产强烈建议）。若入口 URL 被 robots 拦截导致 0 链接，可仅在本地调试时改为 false。
RESPECT_ROBOTS_TXT=true

# ── 任务恢复（API 启动时）────────────────────────────────────
# 将「running」超过该分钟数仍无结束时间的任务标记为失败，避免进程崩溃后无法再次触发流水线
STALE_TASK_RECOVERY_MINUTES=240
