generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                @id @default(cuid(2))
  authId             String?               @unique @map("auth_id")
  email              String                @unique
  name               String?
  avatar             String?
  plan               AccountPlan           @default(FREE)
  generationCount    Int                   @default(0) @map("generation_count")
  generationLimit    Int                   @default(100) @map("generation_limit")
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  exportJobs         ExportJob[]
  files              FileAsset[]
  fabrics            Fabric[]
  generationTasks    GenerationTask[]
  agentConversations AgentConversation[]
  agentRuns          AgentRun[]
  workflowProposals  WorkflowProposal[]
  auditLogs          AuditLog[]
  designDecisions    DesignAssetDecision[]
  ownedWorkspaces    Workspace[]

  @@map("users")
}

enum AccountPlan {
  FREE
  PRO
}

enum ExportFormat {
  PNG
  JPG
  PDF
}

enum ExportQuality {
  STANDARD
  HIGH
}

enum ExportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum DnaExtractionStatus {
  READY
  FAILED
}

enum GenerationTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  MODERATION_FAILED
  CANCELED
}

enum ContentModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REVIEW_REQUIRED
}

enum DesignAssetOperation {
  IMPORTED
  GENERATED
  VARIATION
  INPAINT
  UPSCALE
  RESTORE
}

enum CollectionVariationAxis {
  SILHOUETTE
  FABRIC
  COLOR
  DETAIL
  STYLING
  GARMENT_TYPE
}

enum SimilarityAnalysisStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum AgentMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

model GenerationTask {
  id                   String                   @id @default(cuid(2))
  userId               String                   @map("user_id")
  projectId            String?                  @map("project_id")
  parentAssetId        String?                  @map("parent_asset_id")
  collectionId         String?                  @map("collection_id")
  variationAxis        CollectionVariationAxis? @map("variation_axis")
  garmentTypeCode      String?                  @map("garment_type_code")
  garmentTypeLabel     String?                  @map("garment_type_label")
  slotKey              String?                  @map("slot_key")
  status               GenerationTaskStatus     @default(QUEUED)
  taskType             String                   @map("task_type")
  input                Json
  compiledPrompt       Json?                    @map("compiled_prompt")
  providerJob          Json?                    @map("provider_job")
  output               Json?
  errorCode            String?                  @map("error_code")
  errorMessage         String?                  @map("error_message")
  moderationStatus     ContentModerationStatus  @default(PENDING) @map("moderation_status")
  moderationCategories String[]                 @default([]) @map("moderation_categories")
  moderationCheckedAt  DateTime?                @map("moderation_checked_at")
  manualReviewRequired Boolean                  @default(false) @map("manual_review_required")
  attemptCount         Int                      @default(0) @map("attempt_count")
  countedAt            DateTime?                @map("counted_at")
  startedAt            DateTime?                @map("started_at")
  completedAt          DateTime?                @map("completed_at")
  canceledAt           DateTime?                @map("canceled_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project              Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentAsset          DesignAsset?             @relation("TaskParentAsset", fields: [parentAssetId], references: [id], onDelete: SetNull)
  collection           Collection?              @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  generatedAssets      DesignAsset[]            @relation("TaskGeneratedAssets")
  generationInputs     GenerationInput[]
  agentMessage         AgentMessage?
  designStep           DesignStep?
  agentRunAttempt      AgentRunStepAttempt?
  workflowAttempts     WorkflowAttempt[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([parentAssetId])
  @@index([collectionId, createdAt])
  @@index([status, createdAt])
  @@map("generation_tasks")
}

model GenerationInput {
  id               String         @id @default(cuid(2))
  generationTaskId String         @map("generation_task_id")
  inputType        String         @default("fabric") @map("input_type")
  fabricId         String         @map("fabric_id")
  boardElementId   String         @map("board_element_id")
  role             String
  weight           Float          @default(0.7)
  tagsSnapshot     String[]       @map("tags_snapshot")
  createdAt        DateTime       @default(now()) @map("created_at")
  generationTask   GenerationTask @relation(fields: [generationTaskId], references: [id], onDelete: Cascade)

  @@unique([generationTaskId, boardElementId, fabricId])
  @@index([generationTaskId])
  @@index([fabricId])
  @@map("generation_inputs")
}

model AuditLog {
  id         String   @id @default(cuid(2))
  userId     String?  @map("user_id")
  operation  String
  resource   String
  resourceId String?  @map("resource_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resource, createdAt])
  @@map("audit_logs")
}

model DesignAsset {
  id                  String                     @id @default(cuid(2))
  projectId           String                     @map("project_id")
  generationTaskId    String?                    @map("generation_task_id")
  sourceFileId        String?                    @map("source_file_id")
  parentAssetId       String?                    @map("parent_asset_id")
  rootAssetId         String                     @map("root_asset_id")
  restoredFromAssetId String?                    @map("restored_from_asset_id")
  operation           DesignAssetOperation
  url                 String
  thumbnailUrl        String?                    @map("thumbnail_url")
  width               Int?
  height              Int?
  seed                BigInt?
  archivedAt          DateTime?                  @map("archived_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationTask      GenerationTask?            @relation("TaskGeneratedAssets", fields: [generationTaskId], references: [id], onDelete: SetNull)
  sourceFile          FileAsset?                 @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  parent              DesignAsset?               @relation("AssetLineage", fields: [parentAssetId], references: [id], onDelete: SetNull)
  children            DesignAsset[]              @relation("AssetLineage")
  restoredFrom        DesignAsset?               @relation("AssetRestores", fields: [restoredFromAssetId], references: [id], onDelete: SetNull)
  restoreCopies       DesignAsset[]              @relation("AssetRestores")
  sourceForTasks      GenerationTask[]           @relation("TaskParentAsset")
  heroOfCollection    Collection?                @relation("CollectionHero")
  collectionLook      CollectionLook?
  similarityLeft      CollectionLookSimilarity[] @relation("SimilarityLeftAsset")
  similarityRight     CollectionLookSimilarity[] @relation("SimilarityRightAsset")
  exportJobs          ExportJob[]

  designStep DesignStep?           @relation("StepOutputAsset")
  decisions  DesignAssetDecision[]

  @@unique([projectId, sourceFileId])
  @@index([projectId, createdAt])
  @@index([rootAssetId, createdAt])
  @@index([parentAssetId])
  @@index([generationTaskId])
  @@index([sourceFileId])
  @@index([archivedAt])
  @@map("design_assets")
}

enum FileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum FabricScope {
  PRESET @map("preset")
  USER   @map("user")
}

model FileAsset {
  id               String         @id @default(cuid(2))
  ownerId          String         @map("owner_id")
  originalName     String         @map("original_name")
  mimeType         String         @map("mime_type")
  sizeBytes        Int            @map("size_bytes")
  sha256           String
  objectKey        String         @unique @map("object_key")
  status           FileStatus     @default(PENDING)
  thumbnail256Key  String?        @map("thumbnail_256_key")
  thumbnail1024Key String?        @map("thumbnail_1024_key")
  width            Int?
  height           Int?
  errorMessage     String?        @map("error_message")
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardElements    BoardElement[]
  designAssets     DesignAsset[]
  fabricMainImages Fabric[]       @relation("FabricMainFile")
  trendCovers      TrendItem[]    @relation("TrendCoverFile")

  @@unique([ownerId, sha256])
  @@index([ownerId, status])
  @@map("file_assets")
}

model Fabric {
  id         String      @id @default(cuid(2))
  scope      FabricScope
  ownerId    String?     @map("owner_id")
  mainFileId String      @map("main_file_id")
  tags       String[]
  status     String      @default("active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mainFile   FileAsset   @relation("FabricMainFile", fields: [mainFileId], references: [id], onDelete: Restrict)

  @@index([scope])
  @@index([ownerId])
  @@index([tags], type: Gin)
  @@map("fabrics")
}

model TrendItem {
  id          String     @id @default(cuid(2))
  title       String
  summary     String
  platform    String
  sourceUrl   String     @unique @map("source_url")
  publishedAt DateTime   @map("published_at")
  coverFileId String?    @map("cover_file_id")
  category    String
  tags        String[]   @default([])
  extracted   Json?
  curatedAt   DateTime   @default(now()) @map("curated_at")
  status      String     @default("published")
  coverFile   FileAsset? @relation("TrendCoverFile", fields: [coverFileId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([category])
  @@index([platform])
  @@index([status])
  @@map("trend_items")
}

model TrendDigest {
  id        String   @id @default(cuid(2))
  period    String   @unique
  theme     String
  itemIds   String[] @default([]) @map("item_ids")
  overview  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([period])
  @@map("trend_digests")
}

enum RoleSource {
  DEFAULT
  INFERRED
  MANUAL
}

enum RoleInferenceState {
  NONE
  PENDING
  READY
  FAILED
}

model Workspace {
  id        String    @id @default(cuid(2))
  name      String
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([ownerId])
  @@map("workspaces")
}

model Project {
  id                 String              @id @default(cuid(2))
  wsId               String              @map("ws_id")
  name               String
  coverAssetId       String?             @map("cover_asset_id")
  idempotencyKey     String?             @map("idempotency_key")
  archived           Boolean             @default(false)
  workflowAgentVersion Int                @default(2) @map("workflow_agent_version")
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  workspace          Workspace           @relation(fields: [wsId], references: [id], onDelete: Cascade)
  boardSnapshot      BoardSnapshot?
  boardElements      BoardElement[]
  designAssets       DesignAsset[]
  collections        Collection[]
  generationTasks    GenerationTask[]
  agentConversations AgentConversation[]
  exportJobs         ExportJob[]
  designSteps        DesignStep[]
  agentRuns          AgentRun[]
  workflowGraph      WorkflowGraph?
  workflowProposals  WorkflowProposal[]
  workflowAttempts   WorkflowAttempt[]
  designContext      ProjectDesignContext?
  contextRevisions   ProjectDesignContextRevision[]
  workflowNodeVersions WorkflowNodeVersion[]
  workflowExecutions WorkflowExecution[]
  workflowOutbox WorkflowOutbox[]
  agentTurns AgentTurn[]
  agentPlanRevisions AgentPlanRevision[]

  @@unique([wsId, idempotencyKey])
  @@index([wsId])
  @@map("projects")
}

model Collection {
  id                     String                     @id @default(cuid(2))
  projectId              String                     @map("project_id")
  heroAssetId            String                     @unique @map("hero_asset_id")
  name                   String
  sourceGarmentTypeCode  String?                    @map("source_garment_type_code")
  sourceGarmentTypeLabel String?                    @map("source_garment_type_label")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  project                Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  heroAsset              DesignAsset                @relation("CollectionHero", fields: [heroAssetId], references: [id], onDelete: Restrict)
  dna                    CollectionDna?
  generationTasks        GenerationTask[]
  looks                  CollectionLook[]
  similarities           CollectionLookSimilarity[]
  exportJobs             ExportJob[]

  @@index([projectId, createdAt])
  @@map("collections")
}

model ExportJob {
  id            String        @id @default(cuid(2))
  userId        String        @map("user_id")
  projectId     String        @map("project_id")
  designAssetId String?       @map("design_asset_id")
  collectionId  String?       @map("collection_id")
  format        ExportFormat
  quality       ExportQuality
  status        ExportStatus  @default(QUEUED)
  watermark     Boolean
  maxEdge       Int?          @map("max_edge")
  objectKey     String?       @unique @map("object_key")
  mimeType      String?       @map("mime_type")
  fileName      String?       @map("file_name")
  sizeBytes     Int?          @map("size_bytes")
  errorCode     String?       @map("error_code")
  errorMessage  String?       @map("error_message")
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  expiresAt     DateTime?     @map("expires_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designAsset   DesignAsset?  @relation(fields: [designAssetId], references: [id], onDelete: SetNull)
  collection    Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([designAssetId])
  @@index([collectionId])
  @@map("export_jobs")
}

model CollectionLook {
  collectionId     String                   @map("collection_id")
  designAssetId    String                   @unique @map("design_asset_id")
  ordinal          Int
  variationAxis    CollectionVariationAxis? @map("variation_axis")
  garmentTypeCode  String?                  @map("garment_type_code")
  garmentTypeLabel String?                  @map("garment_type_label")
  slotKey          String?                  @map("slot_key")
  similarityScore  Float?                   @map("similarity_score")
  analysisStatus   SimilarityAnalysisStatus @default(PENDING) @map("analysis_status")
  warningIgnored   Boolean                  @default(false) @map("warning_ignored")
  isHero           Boolean                  @default(false) @map("is_hero")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  collection       Collection               @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  designAsset      DesignAsset              @relation(fields: [designAssetId], references: [id], onDelete: Cascade)

  @@id([collectionId, designAssetId])
  @@unique([collectionId, ordinal])
  @@unique([collectionId, slotKey])
  @@index([collectionId, createdAt])
  @@map("collection_looks")
}

model CollectionLookSimilarity {
  collectionId String      @map("collection_id")
  leftAssetId  String      @map("left_asset_id")
  rightAssetId String      @map("right_asset_id")
  score        Float
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  collection   Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  leftAsset    DesignAsset @relation("SimilarityLeftAsset", fields: [leftAssetId], references: [id], onDelete: Cascade)
  rightAsset   DesignAsset @relation("SimilarityRightAsset", fields: [rightAssetId], references: [id], onDelete: Cascade)

  @@id([collectionId, leftAssetId, rightAssetId])
  @@index([leftAssetId])
  @@index([rightAssetId])
  @@map("collection_look_similarities")
}

model CollectionDna {
  collectionId      String              @id @map("collection_id")
  extractionStatus  DnaExtractionStatus @default(READY) @map("extraction_status")
  palette           Json
  silhouettes       String[]
  fabrics           String[]
  moodWords         String[]            @map("mood_words")
  signatureDetails  String[]            @default([]) @map("signature_details")
  referenceFileIds  String[]            @map("reference_file_ids")
  paletteLocked     Boolean             @default(false) @map("palette_locked")
  silhouettesLocked Boolean             @default(false) @map("silhouettes_locked")
  fabricsLocked     Boolean             @default(false) @map("fabrics_locked")
  moodWordsLocked   Boolean             @default(false) @map("mood_words_locked")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  collection        Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("collection_dna")
}

model BoardSnapshot {
  projectId String   @id @map("project_id")
  snapshot  Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("board_snapshots")
}

model WorkflowGraph {
  projectId      String             @id @map("project_id")
  revision       Int                @default(0)
  layoutRevision Int                @default(0) @map("layout_revision")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes          WorkflowNode[]
  edges          WorkflowEdge[]
  mutations      WorkflowMutation[]

  @@map("workflow_graphs")
}

model WorkflowNode {
  id            String            @id
  projectId     String            @map("project_id")
  kind          String
  type          String
  title         String
  payload       Json
  status        String            @default("ready")
  x             Float
  y             Float
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  graph         WorkflowGraph     @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  outgoingEdges WorkflowEdge[]    @relation("WorkflowEdgeSource")
  incomingEdges WorkflowEdge[]    @relation("WorkflowEdgeTarget")
  attempts      WorkflowAttempt[]

  @@index([projectId, createdAt])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id           String        @id
  projectId    String        @map("project_id")
  sourceNodeId String        @map("source_node_id")
  targetNodeId String        @map("target_node_id")
  sourcePort   String        @map("source_port")
  targetPort   String        @map("target_port")
  createdAt    DateTime      @default(now()) @map("created_at")
  graph        WorkflowGraph @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  sourceNode   WorkflowNode  @relation("WorkflowEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode  @relation("WorkflowEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceNodeId, targetNodeId, targetPort])
  @@index([projectId, createdAt])
  @@index([targetNodeId])
  @@map("workflow_edges")
}

model WorkflowMutation {
  id         String        @id @default(cuid(2))
  projectId  String        @map("project_id")
  mutationId String        @map("mutation_id")
  mode       String
  requestHash String       @map("request_hash")
  baseRevision Int?        @map("base_revision")
  resultRevision Int?      @map("result_revision")
  beforeSnapshot Json?     @map("before_snapshot")
  afterSnapshot Json?      @map("after_snapshot")
  actorId String?          @map("actor_id")
  origin String            @default("user")
  createdAt  DateTime      @default(now()) @map("created_at")
  graph      WorkflowGraph @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, mutationId])
  @@index([projectId, createdAt])
  @@map("workflow_mutations")
}

model WorkflowProposal {
  id           String   @id @default(cuid(2))
  projectId    String   @map("project_id")
  userId       String   @map("user_id")
  baseRevision Int      @map("base_revision")
  status       String   @default("pending")
  diff         Json
  evidence     Json
  mutationId   String   @map("mutation_id")
  conversationId String? @map("conversation_id")
  contextRevision Int? @map("context_revision")
  schemaVersion Int @default(1) @map("schema_version")
  targetNodeVersionId String? @map("target_node_version_id")
  planRevision Int? @map("plan_revision")
  actionFingerprint String? @map("action_fingerprint")
  rejectionReason String? @db.Text @map("rejection_reason")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assistantMessage AgentMessage?

  @@unique([projectId, mutationId])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@map("workflow_proposals")
}

model WorkflowAttempt {
  id               String          @id @default(cuid(2))
  projectId        String          @map("project_id")
  toolNodeId       String          @map("tool_node_id")
  ordinal          Int
  executionKey     String          @unique @map("execution_key")
  status           String
  requestSnapshot  Json            @map("request_snapshot")
  generationTaskId String?         @map("generation_task_id")
  executionId      String?         @map("execution_id")
  nodeVersionId    String?         @map("node_version_id")
  error            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolNode         WorkflowNode    @relation(fields: [toolNodeId], references: [id], onDelete: Restrict)
  generationTask   GenerationTask? @relation(fields: [generationTaskId], references: [id], onDelete: SetNull)

  @@unique([toolNodeId, ordinal])
  @@index([projectId, createdAt])
  @@index([executionId])
  @@map("workflow_attempts")
}

model WorkflowNodeVersion {
  id String @id @default(uuid())
  projectId String @map("project_id")
  nodeId String @map("node_id")
  version Int
  graphRevision Int @map("graph_revision")
  kind String
  type String
  title String
  payload Json
  inputBindings Json @map("input_bindings")
  previousVersionId String? @map("previous_version_id")
  origin String
  actorId String? @map("actor_id")
  mutationId String? @map("mutation_id")
  baseline Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([projectId, graphRevision])
  @@index([nodeId, createdAt])
  @@map("workflow_node_versions")
}

model WorkflowExecution {
  id String @id @default(uuid())
  projectId String @map("project_id")
  toolNodeId String @map("tool_node_id")
  nodeVersionId String? @map("node_version_id")
  conversationId String? @map("conversation_id")
  userId String @map("user_id")
  executionKey String @unique @map("execution_key")
  status String @default("queued")
  expectedAttempts Int @default(1) @map("expected_attempts")
  intentEpoch Int? @map("intent_epoch")
  requestSnapshot Json @map("request_snapshot")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
  @@index([conversationId, createdAt])
  @@map("workflow_executions")
}

model WorkflowOutbox {
  id String @id @default(uuid())
  projectId String @map("project_id")
  eventKey String @unique @map("event_key")
  eventType String @map("event_type")
  executionId String? @map("execution_id")
  attemptId String? @map("attempt_id")
  generationTaskId String? @map("generation_task_id")
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  leaseToken String? @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  processedAt DateTime? @map("processed_at")
  lastError String? @db.Text @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([executionId, createdAt])
  @@map("workflow_outbox")
}

model AgentTurn {
  id String @id @default(uuid())
  projectId String @map("project_id")
  conversationId String @map("conversation_id")
  userId String @map("user_id")
  trigger String @default("user")
  clientRequestId String? @map("client_request_id")
  sourceEventId String? @unique @map("source_event_id")
  intentEpoch Int @map("intent_epoch")
  status String @default("pending")
  leaseToken String? @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  graphRevision Int? @map("graph_revision")
  contextRevision Int? @map("context_revision")
  summaryRevision Int? @map("summary_revision")
  planRevision Int? @map("plan_revision")
  snapshots Json?
  budget Json?
  error String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("agent_turns")
}

model AgentPlanRevision {
  id String @id @default(uuid())
  projectId String @map("project_id")
  conversationId String @map("conversation_id")
  revision Int
  turnId String? @map("turn_id")
  intentEpoch Int @map("intent_epoch")
  graphRevision Int @map("graph_revision")
  contextRevision Int @map("context_revision")
  plan Json
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([conversationId, revision])
  @@index([projectId, createdAt])
  @@map("agent_plan_revisions")
}

model BoardElement {
  id                 String             @id @default(cuid(2))
  projectId          String             @map("project_id")
  shapeId            String             @map("shape_id")
  shapeType          String             @map("shape_type")
  role               String
  roleSource         RoleSource         @default(DEFAULT) @map("role_source")
  roleConfidence     Float?             @map("role_confidence")
  roleLabel          String?            @map("role_label")
  roleInferenceState RoleInferenceState @default(NONE) @map("role_inference_state")
  fileAssetId        String?            @map("file_asset_id")
  record             Json?
  deletedAt          DateTime?          @map("deleted_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileAsset          FileAsset?         @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([projectId, shapeId])
  @@index([projectId, deletedAt])
  @@index([fileAssetId])
  @@map("board_elements")
}

model DesignStep {
  id               String          @id @default(cuid(2))
  projectId        String          @map("project_id")
  generationTaskId String?         @unique @map("generation_task_id")
  outputAssetId    String?         @unique @map("output_asset_id")
  tool             String
  actor            String
  intent           String          @db.Text
  inputSnapshot    Json            @map("input_snapshot")
  createdAt        DateTime        @default(now()) @map("created_at")
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationTask   GenerationTask? @relation(fields: [generationTaskId], references: [id], onDelete: Cascade)
  outputAsset      DesignAsset?    @relation("StepOutputAsset", fields: [outputAssetId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("design_steps")
}

model DesignAssetDecision {
  id              String      @id @default(cuid(2))
  assetId         String      @map("asset_id")
  userId          String      @map("user_id")
  clientRequestId String      @map("client_request_id")
  kind            String
  reason          String      @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  asset           DesignAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, clientRequestId])
  @@index([assetId, createdAt])
  @@map("design_asset_decisions")
}

model AgentConversation {
  id          String         @id @default(cuid(2))
  projectId   String         @map("project_id")
  createdById String         @map("created_by_id")
  title       String
  mode        String         @default("legacy")
  intentEpoch Int            @default(0) @map("intent_epoch")
  activeTurnId String?       @map("active_turn_id")
  activeTurnStartedAt DateTime? @map("active_turn_started_at")
  archivedAt  DateTime?      @map("archived_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages    AgentMessage[]
  runs        AgentRun[]
  proposals   WorkflowProposal[]
  contextSummary AgentContextSummary?

  @@index([projectId, updatedAt])
  @@index([createdById, updatedAt])
  @@map("agent_conversations")
}

model AgentRun {
  id              String            @id @default(cuid(2))
  projectId       String            @map("project_id")
  conversationId  String            @map("conversation_id")
  userId          String            @map("user_id")
  clientRequestId String            @map("client_request_id")
  intent          String            @db.Text
  contextSnapshot Json              @map("context_snapshot")
  status          String            @default("planning")
  revision        Int               @default(0)
  error           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps           AgentRunStep[]

  @@unique([conversationId, clientRequestId])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

model AgentRunStep {
  id               String                @id @default(cuid(2))
  runId            String                @map("run_id")
  key              String
  ordinal          Int
  tool             String
  title            String
  instruction      String                @db.Text
  prompt           String                @db.Text
  negativePrompt   String                @db.Text @map("negative_prompt")
  sourceAssetId    String?               @map("source_asset_id")
  sourceStepKey    String?               @map("source_step_key")
  status           String                @default("pending")
  attempt          Int                   @default(0)
  generationTaskId String?               @map("generation_task_id")
  selectedAssetId  String?               @map("selected_asset_id")
  error            String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  run              AgentRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempts         AgentRunStepAttempt[]

  @@unique([runId, key])
  @@unique([runId, ordinal])
  @@map("agent_run_steps")
}

model AgentRunStepAttempt {
  id               String          @id @default(cuid(2))
  stepId           String          @map("step_id")
  ordinal          Int
  executionKey     String          @unique @map("execution_key")
  requestSnapshot  Json            @map("request_snapshot")
  compiledSnapshot Json?           @map("compiled_snapshot")
  status           String
  leaseToken       String          @map("lease_token")
  leaseExpiresAt   DateTime        @map("lease_expires_at")
  generationTaskId String?         @unique @map("generation_task_id")
  error            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  step             AgentRunStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  generationTask   GenerationTask? @relation(fields: [generationTaskId], references: [id], onDelete: SetNull)

  @@unique([stepId, ordinal])
  @@map("agent_run_step_attempts")
}

model AgentMessage {
  id               String             @id @default(cuid(2))
  conversationId   String             @map("conversation_id")
  role             AgentMessageRole
  status           AgentMessageStatus @default(COMPLETED)
  content          String             @db.Text
  kind             String?
  turnId           String?            @map("turn_id")
  sourceEventId    String?            @map("source_event_id")
  origin           String             @default("user")
  executionId      String?            @map("execution_id")
  proposalId       String?            @unique @map("proposal_id")
  context          Json?
  clientRequestId  String?            @map("client_request_id")
  replyToId        String?            @unique @map("reply_to_id")
  generationTaskId String?            @unique @map("generation_task_id")
  errorCode        String?            @map("error_code")
  errorMessage     String?            @map("error_message")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  conversation     AgentConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo          AgentMessage?      @relation("AgentMessageReply", fields: [replyToId], references: [id], onDelete: Cascade)
  reply            AgentMessage?      @relation("AgentMessageReply")
  generationTask   GenerationTask?    @relation(fields: [generationTaskId], references: [id], onDelete: SetNull)
  proposal         WorkflowProposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  contextRevisions ProjectDesignContextRevision[]

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([status, updatedAt])
  @@index([sourceEventId])
  @@map("agent_messages")
}

model ProjectDesignContext {
  projectId String @id @map("project_id")
  revision Int @default(0)
  state Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_design_contexts")
}

model ProjectDesignContextRevision {
  id String @id @default(cuid(2))
  projectId String @map("project_id")
  revision Int
  state Json
  sourceMessageId String? @map("source_message_id")
  mutationId String? @map("mutation_id")
  requestHash String? @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceMessage AgentMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@unique([projectId, revision])
  @@unique([projectId, mutationId])
  @@index([projectId, createdAt])
  @@map("project_design_context_revisions")
}

model AgentContextSummary {
  conversationId String @id @map("conversation_id")
  summary Json
  throughMessageId String? @map("through_message_id")
  graphRevision Int @map("graph_revision")
  revision Int @default(0)
  focusNodeIds String[] @default([]) @map("focus_node_ids")
  currentTask String? @db.Text @map("current_task")
  updatedAt DateTime @updatedAt @map("updated_at")
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("agent_context_summaries")
}

model ImageVisualSummary {
  fingerprint String @id
  sourceKey String @map("source_key")
  status String
  summary Json?
  error String? @db.Text
  model String
  schemaVersion String @map("schema_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([sourceKey, model, schemaVersion, updatedAt(sort: Desc)], map: "image_visual_summary_source_lookup_idx")
  @@map("image_visual_summaries")
}
