generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(cuid(2))
  authId          String?     @unique @map("auth_id")
  email           String      @unique
  name            String?
  avatar          String?
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  ownedWorkspaces Workspace[]

  @@map("users")
}

model Workspace {
  id        String    @id @default(cuid(2))
  name      String
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([ownerId])
  @@map("workspaces")
}

model Project {
  id             String    @id @default(cuid(2))
  wsId           String    @map("ws_id")
  name           String
  coverAssetId   String?   @map("cover_asset_id")
  idempotencyKey String?   @map("idempotency_key")
  archived       Boolean   @default(false)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [wsId], references: [id], onDelete: Cascade)
  boardSnapshot  BoardSnapshot?
  boardElements  BoardElement[]

  @@index([wsId])
  @@unique([wsId, idempotencyKey])
  @@map("projects")
}

model BoardSnapshot {
  projectId String   @id @map("project_id")
  snapshot  Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("board_snapshots")
}

model BoardElement {
  id        String    @id @default(cuid(2))
  projectId String    @map("project_id")
  shapeId   String    @map("shape_id")
  shapeType String    @map("shape_type")
  role      String
  record    Json?
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, shapeId])
  @@index([projectId, deletedAt])
  @@map("board_elements")
}
