generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(cuid(2))
  authId          String?     @unique @map("auth_id")
  email           String      @unique
  name            String?
  avatar          String?
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  files           FileAsset[]
  ownedWorkspaces Workspace[]

  @@map("users")
}

enum FileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model FileAsset {
  id               String     @id @default(cuid(2))
  ownerId          String     @map("owner_id")
  originalName     String     @map("original_name")
  mimeType         String     @map("mime_type")
  sizeBytes        Int        @map("size_bytes")
  sha256           String
  objectKey        String     @unique @map("object_key")
  status           FileStatus @default(PENDING)
  thumbnail256Key  String?    @map("thumbnail_256_key")
  thumbnail1024Key String?    @map("thumbnail_1024_key")
  width            Int?
  height           Int?
  errorMessage     String?    @map("error_message")
  completedAt      DateTime?  @map("completed_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardElements    BoardElement[]

  @@unique([ownerId, sha256])
  @@index([ownerId, status])
  @@map("file_assets")
}

enum RoleSource {
  DEFAULT
  INFERRED
  MANUAL
}

enum RoleInferenceState {
  NONE
  PENDING
  READY
  FAILED
}

model Workspace {
  id        String    @id @default(cuid(2))
  name      String
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([ownerId])
  @@map("workspaces")
}

model Project {
  id             String    @id @default(cuid(2))
  wsId           String    @map("ws_id")
  name           String
  coverAssetId   String?   @map("cover_asset_id")
  idempotencyKey String?   @map("idempotency_key")
  archived       Boolean   @default(false)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [wsId], references: [id], onDelete: Cascade)
  boardSnapshot  BoardSnapshot?
  boardElements  BoardElement[]

  @@index([wsId])
  @@unique([wsId, idempotencyKey])
  @@map("projects")
}

model BoardSnapshot {
  projectId String   @id @map("project_id")
  snapshot  Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("board_snapshots")
}

model BoardElement {
  id                 String             @id @default(cuid(2))
  projectId          String             @map("project_id")
  shapeId            String             @map("shape_id")
  shapeType          String             @map("shape_type")
  role               String
  roleSource         RoleSource         @default(DEFAULT) @map("role_source")
  roleConfidence     Float?             @map("role_confidence")
  roleLabel          String?            @map("role_label")
  roleInferenceState RoleInferenceState @default(NONE) @map("role_inference_state")
  fileAssetId        String?            @map("file_asset_id")
  record             Json?
  deletedAt          DateTime?          @map("deleted_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileAsset          FileAsset?         @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([projectId, shapeId])
  @@index([projectId, deletedAt])
  @@index([fileAssetId])
  @@map("board_elements")
}
