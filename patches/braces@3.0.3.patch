diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,59 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: bound recursion independently of input length.
+// Keep this a hard ceiling so options cannot restore unbounded traversal.
+const MAX_DEPTH = 100;
+
+const checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    const error = new SyntaxError(`Brace AST nesting exceeds maximum depth (${MAX_DEPTH})`);
+    error.code = 'ERR_BRACES_MAX_DEPTH';
+    throw error;
+  }
+};
+
+const invalidAst = () => {
+  const error = new SyntaxError('Cyclic brace AST is not supported');
+  error.code = 'ERR_BRACES_INVALID_AST';
+  throw error;
+};
+
+// Iterative validation also protects public methods accepting external ASTs.
+// Only child links are traversed: parser-created parent/prev backlinks are valid.
+const validateAst = (ast, checkParents = false) => {
+  const pending = [{ node: ast, depth: ast && ast.type === 'root' ? 0 : 1 }];
+  const active = new Set();
+
+  while (pending.length > 0) {
+    const { node, depth, exit } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (exit) {
+      active.delete(node);
+      continue;
+    }
+    if (active.has(node)) invalidAst();
+
+    if (checkParents) {
+      const parents = new Set();
+      let parent = node.parent;
+      let parentDepth = 0;
+      while (parent && parent.type !== 'brace' && parent.type !== 'root' && parent.parent) {
+        if (parents.has(parent)) invalidAst();
+        parents.add(parent);
+        checkDepth(++parentDepth);
+        parent = parent.parent;
+      }
+    }
+
+    if (!Array.isArray(node.nodes)) continue;
+    checkDepth(depth);
+    active.add(node);
+    pending.push({ node, depth, exit: true });
+    for (let index = node.nodes.length - 1; index >= 0; index--) {
+      const child = node.nodes[index];
+      pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
+module.exports = { checkDepth, validateAst };
