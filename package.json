{
  "name": "ai-fashion-design-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "pnpm build:packages && turbo run dev",
    "local:start": "start-platform.cmd",
    "runway:doctor": "node scripts/runway.mjs doctor",
    "runway:up": "node scripts/runway.mjs up",
    "runway:down": "node scripts/runway.mjs down",
    "runway:test": "node scripts/runway.mjs test",
    "runway:test:integration": "node scripts/runway.mjs integration",
    "runway:smoke": "node scripts/runway.mjs smoke",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/turbo/bin/turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:visual": "node scripts/run-visual-e2e.mjs",
    "test:e2e:real": "node scripts/run-trial-e2e.mjs",
    "test:startup": "node --test scripts/check-ports.spec.mjs",
    "check": "pnpm test:startup && pnpm audit:all && pnpm lint && pnpm typecheck && pnpm db:validate && pnpm test && pnpm db:test && pnpm build",
    "audit:all": "node scripts/audit-dependencies.mjs",
    "audit:prod": "pnpm audit --prod --audit-level low",
    "test:dependency-security": "node scripts/verify-dependency-security.mjs",
    "db:generate": "pnpm --filter @fashion/db generate",
    "db:migrate": "pnpm --filter @fashion/db migrate",
    "db:deploy": "pnpm --filter @fashion/db exec prisma migrate deploy",
    "db:test": "pnpm --filter @fashion/db test:integration",
    "db:validate": "pnpm --filter @fashion/db db:validate",
    "auth:start": "supabase start",
    "auth:status": "supabase status",
    "auth:stop": "supabase stop",
    "infra:check": "node scripts/check-ports.mjs",
    "infra:up": "pnpm infra:check && docker compose up -d --wait postgres redis minio && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "verify:file-pipeline": "pnpm --filter @fashion/worker exec tsx --tsconfig ../../apps/api/tsconfig.json ../../scripts/verify-file-pipeline.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "1.58.2",
    "braces": "3.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.4.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "supabase": "2.76.15",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
