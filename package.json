{
  "name": "ai-fashion-design-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "pnpm build:packages && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @fashion/db generate",
    "db:migrate": "pnpm --filter @fashion/db migrate",
    "db:validate": "pnpm --filter @fashion/db db:validate",
    "infra:check": "node scripts/check-ports.mjs",
    "infra:up": "pnpm infra:check && docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.12",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
